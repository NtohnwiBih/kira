# ─────────────────────────────────────────────────────────────────────────────
# Kira AI Gateway V3 — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI Models ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Primary reasoning model — cost-optimised
OPENAI_CHAT_MODEL=gpt-4.5-mini

# Fallback for high-complexity only (rare)
OPENAI_FALLBACK_MODEL=gpt-4.5

# Realtime-grade whisper for speech-to-text
OPENAI_WHISPER_MODEL=whisper-1

# TTS — "tts-1" (speed) or "tts-1-hd" (quality)
OPENAI_TTS_MODEL=tts-1-hd

# Voice persona — alloy | echo | fable | onyx | nova | shimmer
OPENAI_TTS_VOICE=nova

# ── Internal Security ─────────────────────────────────────────────────────
SERVICE_KEY=kira_internal_key_change_me_in_production

# ── NestJS Backend ────────────────────────────────────────────────────────
BACKEND_BASE_URL=http://nestjs-backend:4000/api/v1
BACKEND_TIMEOUT_SECS=10.0
BACKEND_MAX_RETRIES=3

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=20

# ── App ───────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_PER_USER=30
RATE_LIMIT_PER_IP=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Memory ────────────────────────────────────────────────────────────────
CHAT_HISTORY_TTL=86400
CHAT_HISTORY_MAX_MSGS=20
SUMMARY_EVERY_N_MSGS=10

# ── Cache ─────────────────────────────────────────────────────────────────
RESPONSE_CACHE_TTL=300
TOOL_CACHE_TTL=60
PROFILE_CACHE_TTL=3600

# ── Circuit Breaker ───────────────────────────────────────────────────────
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT=30

# ── Safety ────────────────────────────────────────────────────────────────
SAFETY_MAX_INPUT_CHARS=4000
SAFETY_ENABLED=true
